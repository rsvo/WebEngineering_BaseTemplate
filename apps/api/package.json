{
  "name": "@playground/api",
  "version": "1.0.0",
  "description": "Bears API / backend-for-frontend (Fastify)",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env.example --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.example --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.example --env-file-if-exists=.env src/db/seed.ts",
    "db:seed:comments": "tsx --env-file=.env.example --env-file-if-exists=.env src/db/seed-comments.ts",
    "race:reports": "tsx --env-file=.env.example --env-file-if-exists=.env src/scripts/report-race.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
