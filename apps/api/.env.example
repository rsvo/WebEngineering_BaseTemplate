# Defaults for `npm run dev`, matching the db service in compose.yaml
# (start it with `docker compose up -d db`). Not secret: local development only.
# Overrides go into apps/api/.env (git-ignored).
DATABASE_URL=postgres://bears:bears@localhost:5432/bears
# Seeded by `npm run db:seed` as moderator@example.org (MODERATOR_EMAIL).
MODERATOR_PASSWORD=local-moderator-password
